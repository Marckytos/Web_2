<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRUD</title>
</head>
<body>
    
    <!-- listar usuarios -->

    <h1>Usuarios</h1>
    <table>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Acciones</th>
        </tr>
        <% users.forEach(user=> {  %>
        <tr>
            <td> <%= user.id %> </td>
            <td> <%= user.name %> </td>
            <td> <%= user.email %> </td>
            <td>
                <a href="/edit/<%= user.id %>">editar</a>
                <a href="/delete/<%= user.id %>">eliminar</a>
            </td>
        </tr>
        <% }); %>
    </table>

</body>
</html>